# syntax=docker/dockerfile:1.7
# ArduPilot source comes from the ardupilot/ardupilot submodule (pinned via
# its checked-out commit, not a build arg). To change the version:
#   cd ardupilot/ardupilot && git fetch --depth 1 origin tag <ref> && git checkout <ref>
#   git submodule update --init --recursive --depth 1
# then commit the updated submodule pointer.
FROM debian:bookworm-slim

ARG DEBIAN_FRONTEND=noninteractive

# git, python3-dev, and xfonts-base are installed below by
# install-prereqs-ubuntu.sh itself (as part of its BASE_PKGS/SITL_PKGS and
# venv setup); listing them here too would just duplicate that work.
RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo bash ca-certificates python3 python3-pip python3-empy iproute2 \
 && useradd --create-home --uid 10001 -G dialout sitl \
 && sh -c 'echo "sitl    ALL=(ALL:ALL) NOPASSWD: ALL" >> /etc/sudoers' \
 && mkdir /opt/ardupilot \
 && chown sitl:sitl /opt/ardupilot

WORKDIR /opt/ardupilot
USER sitl

# Install build prerequisites from just the installer script first, so this
# (slow) layer is cached until the script itself changes rather than on
# every change to ArduPilot's source.
ADD ardupilot/Tools/environment_install/* Tools/environment_install/
ADD ardupilot/Tools/completion/* Tools/completion/
ADD ardupilot/Tools/scripts/* Tools/scripts/
RUN USER=sitl ./Tools/environment_install/install-prereqs-ubuntu.sh -y

COPY --chown=sitl:sitl ardupilot/ ./
RUN . ~/.profile && ./waf configure --board sitl \
 && ./waf copter plane \
 && ./waf build --target bin/arducopter \
 && ./waf build --target bin/arduplane

# VEHICLE: ArduCopter or ArduPlane
# FRAME examples: quad (Copter), plane (Plane)
# Set LOCATION to a built-in locations.txt name, or set HOME_POS to lat,lon,alt,heading.
# MAVPROXY_OUTS is a space-separated list of MAVProxy --out endpoints.
ENV VEHICLE=ArduCopter \
    FRAME=quad \
    LOCATION=CMAC \
    HOME_POS= \
    INSTANCE=0 \
    SPEEDUP=1 \
    PARAM_FILE= \
    MAVPROXY_OUTS=""

COPY start-sitl /usr/local/bin/
RUN sudo mkdir -p /config /data \
 && sudo chown -R sitl:sitl /config /data

WORKDIR /data
VOLUME ["/config", "/data"]

# SITL's direct TCP endpoint and the default UDP endpoint for host-based tools.
EXPOSE 5760/tcp 14550/udp
ENTRYPOINT ["/usr/local/bin/start-sitl"]
