	<xs:simpleType name="ServiceStateEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the Status state machine for a Service.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="INITIALIZING">
				<xs:annotation>
					<xs:documentation>Indicates the Service is starting up. Communication has begun but Service startup is not complete (e.g. still loading configuration files).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NORMAL">
				<xs:annotation>
					<xs:documentation>Indicates the Service is functioning normally. Configuration files loaded.  All functions can now be used.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEGRADED">
				<xs:annotation>
					<xs:documentation>Indicates the Service is not functioning normally. Functions can be used, but there may be limitations.  Some defined Service functions may be available but may not be relied upon due to degraded state of Service.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PAUSED">
				<xs:annotation>
					<xs:documentation>Indicates the Service is functioning properly, but has been paused (e.g. by operator interaction, because of dependency).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INOPERABLE">
				<xs:annotation>
					<xs:documentation>Indicates the Service is unusable.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
