		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="NONE">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ACTIVATION">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEACTIVATION">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ARRIVAL">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEPARTURE">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TIME_POINT_ESTABLISHED">
				<xs:annotation>
					<xs:documentation>The time that the reported position was established. May be prior to time of data entry.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NON_OPERATIONAL_TIME">
				<xs:annotation>
					<xs:documentation>The time that the site is expected to become less than fully operational.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OPERATIONAL_TIME">
				<xs:annotation>
					<xs:documentation>The time that the site is expected to return fully operational.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TIME_OF_REPORT">
				<xs:annotation>
					<xs:documentation>The time that the report was released for transmission.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ARRIVE_ON_STATION">
				<xs:annotation>
					<xs:documentation>Time the unit will arrive on station.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TIME_REMAINING_ON_STATION">
				<xs:annotation>
					<xs:documentation>Time the unit will be required to leave its current task, taking into account such operational factions as fuel state, weather, distance from base, etc.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEPART_STATION">
				<xs:annotation>
					<xs:documentation>The time that a unit is scheduled to leave its station in accordance with its mission plan, or the time of day that the unit left its station.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TIME_ON_TARGET">
				<xs:annotation>
					<xs:documentation>The time that a unit is scheduled to arrive on target.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TIME_FIRST_ACQ_TIME_DATUM_EST">
				<xs:annotation>
					<xs:documentation>The time of first acquisition for the contact or, for datum type, the time the datum was established.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TIME_OF_CURRENT_POS_DATA">
				<xs:annotation>
					<xs:documentation>The time of current position data report while contact is maintained on the track.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TIME_CONTACT_LOST">
				<xs:annotation>
					<xs:documentation>The time of last position data report received after contact has been lost on the track.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
