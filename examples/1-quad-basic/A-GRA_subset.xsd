	<xs:simpleType name="NotationType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>A string representing the notation for ELNOT or CENOT. ELNOT is Electronic Intelligence (ELINT) Notation for non-communications electronic emissions. CENOT is Communications Emitter Notation for communications electronic emissions.</xs:documentation>
