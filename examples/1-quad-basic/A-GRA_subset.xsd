	<xs:simpleType name="MissionCommunicationsStateEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This element specifies the state of communications between a system and its controlling system.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ACTIVE">
				<xs:annotation>
					<xs:documentation>Indicates that there is sufficient communications between the vehicle and its controlling system to achieve command and control of the vehicle, regardless of data rate and whether the communication is direct or via relay.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LOST">
				<xs:annotation>
					<xs:documentation>Indicates that there is no communications or insufficient communications between the vehicle and its controlling system to achieve command and control of the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PLANNED_LOST">
				<xs:annotation>
					<xs:documentation>Indicates that the vehicle is in a preplanned state where there is no communications or insufficient communications between the vehicle and its controlling system to achieve command and control of the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EMCON">
				<xs:annotation>
					<xs:documentation>Indicates that the vehicle is not transmitting over any of its links.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
