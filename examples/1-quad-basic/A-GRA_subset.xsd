	<xs:complexType name="EndPointType" uci:version="003.000.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="WayPoint" type="uci:WayPointType">
				<xs:annotation>
					<xs:documentation>This element is used to specify a point in the route where no turning occurs.  It is generally used for points associated with Actions such as task "transitions", changes in acceleration, changes in speed, changes in altitude, etc.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TurnPoint" type="uci:TurnPointType">
				<xs:annotation>
					<xs:documentation>This element is used to specify all cases of turns in a segment including fly-through and turn-short.  It can additionally be associated with tasks/actions that require or are coincident with turns.  TurnPoints will generally come in groups of at least two in linked PathSegments.  All but the last in a group will include a TurnRadius.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LoiterPoint" type="uci:LoiterPointType">
				<xs:annotation>
					<xs:documentation>This element specifies a Loiter.  Currently specifying a task/action associated with a LoiterPoint when the task/action occurs only during a portion of the Loiter is not supported.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="EnduranceBaseType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates endurance in terms of maximum distance that can be reached given the current system state.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Fuel" type="uci:MassType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Measure of current or planned fuel.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Duration" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Estimated time of operation with current or planned fuel/charge/power.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DurationEnd" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Estimated time at which operation with current or planned fuel/charge/power will end.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Percent" type="uci:PercentType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Percent of fuel/charge/power remaining or planned, expressed as a percentage of total capacity.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EnduranceFootprintType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Boundary" type="uci:BoundaryType">
				<xs:annotation>
					<xs:documentation>Indicates the boundary of the endurance footprint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReferenceAltitude" type="uci:AltitudeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the Height Above Ellipsoid (HAE) reference for the footprint.  This element is required when the footprint is based on a smooth earth model and the sibling Boundary element doesn't specify Altitude.  It should be omitted otherwise.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Duration" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates estimated remaining time of operation with current fuel/charge/power plus the estimated time remaining until the endurance footprint shrinks to its smallest size.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EnduranceType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>Indicates endurance in terms of maximum ground/surface distance that can be reached given the current system state.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:EnduranceBaseType">
				<xs:sequence>
					<xs:element name="Footprint" type="uci:EnduranceFootprintType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates endurance in terms of maximum ground/surface distance that can be reached given the current System state.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:simpleType name="EntityFusionEligibilityEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the level of eligibility for automated fusion.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="FULL">
				<xs:annotation>
					<xs:documentation>Indicates automatic fusion is allowed with any other Entity or Entities.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SELECTIVE_EXCLUSION">
				<xs:annotation>
					<xs:documentation>Indicates automatic fusion is allowed in general but with specific Entity or Entities excluded.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SELECTIVE_INCLUSION">
				<xs:annotation>
					<xs:documentation>Indicates automatic fusion is allowed but only with specific Entity or Entities.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NONE">
				<xs:annotation>
					<xs:documentation>Indicates automatic fusion is not allowed for an Entity or Entities.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EnvironmentEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the environment or "domain" of operation. Derived from MIL-STD-6016; see MIL-STD-6016 DFI/DUI 275/004 for additional details.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AIR">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is operating in the airborne environment or "domain".</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SPACE">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is operating in the space (upper atmosphere) environment or "domain".</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GROUND">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is operating in the ground/terrestrial environment or "domain".</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEA_SURFACE">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is operating in the sea surface environment or "domain".</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEA_SUBSURFACE">
				<xs:annotation>
					<xs:documentation>Indicates the Entity is operating in the sea subsurface environment or "domain".</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>Indicates the environment or "domain" in which the Entity is operating is not known.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="EnvironmentIdentityType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Environment" type="uci:EnvironmentEnum">
				<xs:annotation>
					<xs:documentation>Indicates the environment or "domain" in which the Entity is operating. Derived from MIL-STD-6016; see MIL-STD-6016 DFI/DUI 275/004 for additional details. Each environment has a corresponding set of specific types.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitRegime" type="uci:OrbitRegimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the predominant orbital regime of the Entity, which is not always the current orbital regime. This element is a supplemental, more detailed description of the orbit when the environment is SPACE.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="EventSeverityEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>An enumeration specifying the significance of the audit event. See enumerated type annotations for further details.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="CRITICAL">
				<xs:annotation>
					<xs:documentation>A security event has been detected and significant information or mechanisms have been compromised. The system may no longer be assumed to be operating correctly in support of the security policy. Immediate action is required.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ERROR">
				<xs:annotation>
					<xs:documentation>A security event has been detected and less significant information or mechanisms have been compromised. Action is required within a given time.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INFORMATIONAL">
				<xs:annotation>
					<xs:documentation>Normal operational messages that may be collected for reporting, measuring throughput, etc. No action is required.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WARNING">
				<xs:annotation>
					<xs:documentation>A warning indication that a security event may occur if action is not taken.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
