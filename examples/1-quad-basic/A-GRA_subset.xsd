				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MANNED_AIRCRAFT">
				<xs:annotation>
					<xs:documentation>Aircraft with one or more human pilots aboard.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MANNED_SHIP">
				<xs:annotation>
					<xs:documentation>Ship or boat with one or more human operators aboard.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MANNED_GROUND_VEHICLE">
				<xs:annotation>
					<xs:documentation>Ground vehicle with one or more human operators aboard.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNMANNED_AIRCRAFT">
				<xs:annotation>
					<xs:documentation>Aircraft without a human pilot aboard.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNMANNED_SHIP">
				<xs:annotation>
					<xs:documentation>Ship or boat without a human operator aboard.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNMANNED_GROUND_VEHICLE">
				<xs:annotation>
					<xs:documentation>Ground vehicle without a human operator aboard.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SATELLITE">
				<xs:annotation>
					<xs:documentation>Artificial object which has been intentionally placed into orbit for the purposes of observation, communication, or navigation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUBMARINE">
				<xs:annotation>
					<xs:documentation>Watercraft capable of independent operation underwater.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TROOPS_INSURGENTS_OR_PEOPLE">
				<xs:annotation>
					<xs:documentation>A group of people.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NO_STATEMENT">
				<xs:annotation>
					<xs:documentation>Indicates that no information is being transmitted. (This does not necessarily indicate that the originator does not have the information.)</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>Indicates that the threat type has not been determined.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
