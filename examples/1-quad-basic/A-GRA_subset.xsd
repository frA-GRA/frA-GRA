	<xs:complexType name="NavigationReportMDT" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the System corresponding to this NavigationReport.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Source" type="uci:SystemSourceEnum">
				<xs:annotation>
					<xs:documentation>Indicates the source of the data in sibling elements.  See enumeration annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ContingencyLevel" type="uci:SystemContingencyLevelEnum">
				<xs:annotation>
					<xs:documentation>Designates the current contingency state of the System.  Contingencies can be an indication that the System will/has autonomously modified its means of navigation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Endurance" type="uci:EnduranceType">
				<xs:annotation>
					<xs:documentation>Indicates the System's remaining endurance.  It is expected that at least one of the optional children are populated in this context.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Navigation" type="uci:NavigationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Vehicle navigation method currently employed.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="NavigationReportMT" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:NavigationReportMDT">
