	<xs:simpleType name="SAR_IdentifierType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>(U) All currently valid SAR controls from the published register
						 PERMISSIBLE VALUES

						 The permissible values for this simple type are defined in the Controlled Value Enumeration:

						 CVEnumISMSAR.xml</xs:documentation>
		</xs:annotation>
