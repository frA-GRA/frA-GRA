			<xs:element name="SpecificType" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Indicates the "specific type" of the Entity. Derived from MIL-STD-6016; see MIL-STD-6016 DFI/DUIs 804/001, 808/001, 809/001, 810/001 and 749/002 for additional details. In MIL-STD-6016, specific type indexes/values vary by environment and therefore this element is only meaningful when paired with the sibling SpecificTypeCategory element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecificTypeCategory" type="uci:EnvironmentEnum">
				<xs:annotation>
					<xs:documentation>Indicates the MIL-STD-6016 list/category of the sibling SpecificType. Derived from MIL-STD-6016; see MIL-STD-6016 DFI/DUI 275/004 for additional details. Each environment has a corresponding set of specific types.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SiteType" type="uci:SiteTypeEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the site type of a Ground Entity.  For example see MIL-STD-6016 DFI/DUI 1555/001.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecificTypeModel" type="uci:SpecificTypeModelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the alpha character suffix used to designate a certain version of an alpha/numeric aircraft designator.  Use of a single character indicates the MIL-STD-6016 aircraft version of sibling SpecificType; see MIL-STD-6016 DFI/DUI 1661/001 for additional details.  Use of a longer string is program dependent.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="SpecificTypeModelType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The model designation suffix of a specific type of vehicle. Indicates the alpha character suffix used to designate a certain version of an alpha/numeric aircraft designator.  Use of a single character indicates the MIL-STD-6016 aircraft version; see MIL-STD-6016 DFI/DUI 1661/001 for additional details.  Use of a longer string is program dependent.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:length value="4" />
			<xs:pattern value="[A-Za-z0-9]{4}" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SpeedType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates speed in meters per second (m/s).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:double" />
	</xs:simpleType>
	<xs:simpleType name="StandardIdentityEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the standard identity of a track.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="PENDING">
				<xs:annotation>
					<xs:documentation>A track which has not been subjected to the identification process.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>An evaluated track which has not been identified.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ASSUMED_FRIEND">
				<xs:annotation>
					<xs:documentation>A track which is assumed to be a friend because of its characteristics, behavior, or origin.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FRIEND">
				<xs:annotation>
					<xs:documentation>A track belonging to a declared friendly nation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NEUTRAL">
				<xs:annotation>
					<xs:documentation>A track or contact whose characteristics, behavior, origin, or nationality indicate that it is neither supporting nor opposing friendly forces.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUSPECT">
				<xs:annotation>
					<xs:documentation>A track which is potentially hostile because of its characteristics, behavior, origin, or nationality.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HOSTILE">
				<xs:annotation>
					<xs:documentation>A track declared to belong to any opposing nation, party, group, or entity, which by virtue of its behavior or information collected on it such as characteristics, origin or nationality contributes to the threat to friendly forces.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNDEFINED">
				<xs:annotation>
					<xs:documentation>An track which has not yet been evaluated.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="StandardIdentityType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="StandardIdentity" type="uci:StandardIdentityEnum">
				<xs:annotation>
					<xs:documentation>Indicates the "standard identity" of the Entity. Derived from MIL-STD-6016; see MIL-STD-6016 DFI/DUI 376/007 for additional details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Allegiance" type="uci:CountryCodeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>DOD standard country code designator to which an entity owes its allegiance.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="StateTransitionStatusEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates whether or not the Subsystem is transitioning between states, or transitioning to its SHUTDOWN state.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="NOT_TRANSITIONING">
				<xs:annotation>
					<xs:documentation>Indicates Subsystem is not actively in the process of transitioning between states.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SHUTTING_DOWN">
				<xs:annotation>
					<xs:documentation>Indicates Subsystem is actively in the process of transitioning to its SHUTDOWN state.  Use the TRANSITIONING enumeration when transitioning to states other than SHUTDOWN.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TRANSITIONING">
				<xs:annotation>
					<xs:documentation>Indicates Subsystem is actively in the process of transitioning to another state other than SHUTDOWN.  Use the SHUTTING_DOWN enumeration when specifically transitioning to the SHUTDOWN state.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="StoreCategoryEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates which MIL-STD-6016 enumeration should be used to interpret the StoreType field.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AIR">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEA_SURFACE">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEA_SURFACE_SAMSSM">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEA_SUBSURFACE">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GROUND">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GUN">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="StoreType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="StoreType" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Indicates the "store type" or weapon type. Derived from MIL-STD-6016; For StoreCategory=AIR use DFI=1623 DUI=001. For SEA_SURFACE use DFI= 399 DUI=004. For SEA_SURFACE_SAMSSM use DFI=1622 DUI=001. For SEA_SUBSURFACE use DFI=399 DUI=004. For GROUND use DFI=399 DUI=004. For GUN StoreType indicates that there is a gun present. This schema will not redefine the enumerations. It is left to applications using this schema to enforce compatibility with MIL-STD-6016.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StoreCategory" type="uci:StoreCategoryEnum">
				<xs:annotation>
					<xs:documentation>Indicates which MIL-STD-6016 enumeration should be used to interpret the StoreType field.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StoreTypeVariant" type="uci:ForeignKeyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Variant is used to declare a specific sub-type of the weapon called out in the StoreType element. The MIL-STD-6016 weapon type list does not include all possible differences in warhead fusing, store configuration, and other small details. This field allows an option addition of information to cover this gap.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="StrengthRangeType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>This type defines the strength range for a track.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Minimum" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Minimum estimated strength. If no value is provided a minimum value of 0 is assumed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Maximum" type="xs:unsignedInt" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Maximum estimated strength. If no value is provided the strength is defined as &gt;StrengthMin.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="StrengthType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>This type defines the minimum, maximum strength values and the percentage of tracked vehicles associated with an Entity.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="StrengthValue" type="uci:StrengthRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Represents the number of objects/entities represented by this Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VehicleCount" type="uci:StrengthRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the total number of vehicles associated with the Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PercentTracked" type="uci:PercentRangeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Percentage of ground vehicles that are tracked type vehicles.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="SubmarineConfidenceLevelEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Expresses an assessment as to whether contacts are of submarine origin with added assessment of the confidence level.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="NO_STATEMENT">
				<xs:annotation>
					<xs:documentation>No attempt made to assess the contact.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNCLASSIFIED">
				<xs:annotation>
					<xs:documentation>Attempt made to assess the contact, but no determination can be made.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="POS_SUB_LOW_ONE">
				<xs:annotation>
					<xs:documentation>Contact assessed to be possible submarine with negligible probability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="POS_SUB_LOW_TWO">
				<xs:annotation>
					<xs:documentation>Contact assessed to be possible submarine with very low probability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="POS_SUB_HIGH_THREE">
				<xs:annotation>
					<xs:documentation>Contact assessed to be possible submarine with low probability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="POS_SUB_HIGH_FOUR">
				<xs:annotation>
					<xs:documentation>Contact assessed to be possible submarine with medium probability.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PROBABLE_SUB">
				<xs:annotation>
					<xs:documentation>Contact assessed to be probably submarine.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CERTAIN_SUB">
				<xs:annotation>
					<xs:documentation>Contact assessed to be submarine with 100% certainty.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NON_SUB">
				<xs:annotation>
					<xs:documentation>Non Submarine.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SURFACE_VESSEL">
				<xs:annotation>
					<xs:documentation>Surface Vessel.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="SubsystemEnabledSettingType" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SubsystemSetting" type="uci:SubsystemSettingEnum">
				<xs:annotation>
					<xs:documentation>Indicates the enabled Subsystem setting.  See enumeration annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubsystemSettingParameter" type="xs:unsignedInt" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the current parameter/level at which the sibling SubsystemSetting is being used.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SubsystemExtendedStatusPET" abstract="true" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Abstract extension type for Subsystem Specific Status.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ComponentExtendedStatusPET" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SubsystemID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type that refers to an aggregation of Capabilities.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SubsystemMaintenanceID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the unique ID of a maintenance test.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:simpleType name="SubsystemSettingEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates Capability and Service independent settings for Subsystems.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="LIVE">
				<xs:annotation>
					<xs:documentation>Indicates a setting in which the Subsystem operates using live inputs and outputs and with functional behaviors as expected in real missions.  This setting is generally expected to be mutually exclusive with the EXERCISE and SIMULATION settings.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EXERCISE">
				<xs:annotation>
					<xs:documentation>Indicates a setting in which the Subsystem operates with exercise inputs and outputs as expected in exercise missions.  This setting is generally expected to be mutually exclusive with the LIVE and SIMULATION settings.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SIMULATION">
				<xs:annotation>
					<xs:documentation>Indicates a setting in which the Subsystem operates with simulated inputs and outputs as expected in simulated missions.  This setting is generally expected to be mutually exclusive with the LIVE and EXERCISE settings.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TEST">
				<xs:annotation>
					<xs:documentation>Indicates a setting in which the Subsystem operates with test inputs, outputs and functional behaviors.  This setting is generally expected to be additive to the LIVE, EXERCISE and/or SIMULATION settings.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TEST_INSTRUMENTATION">
				<xs:annotation>
					<xs:documentation>Indicates a setting in which the Subsystem operates with test instrumentation outputs and functional behaviors.  This setting is generally expected to be additive to the TEST setting.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DATA_RECORDING">
				<xs:annotation>
					<xs:documentation>Indicates a setting in which the Subsystem operates with data recording outputs and functional behaviors.  This setting is independent of other Subsystem settings.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEBUG_REPORTING">
				<xs:annotation>
					<xs:documentation>Indicates a setting in which the Subsystem operates with debug reporting outputs and functional behaviors.  This setting is independent of other Subsystem settings.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TRANSMIT_LEVEL">
				<xs:annotation>
					<xs:documentation>Indicates a setting in which the Subsystem operates at a specified power level.  This setting is independent of other Subsystem settings.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="SubsystemSettingParameterType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ParameterNumber" type="xs:unsignedInt">
				<xs:annotation>
					<xs:documentation>Indicates the Subsystem settings parameter's identifying number/index.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DescriptiveLabel" type="uci:VisibleString256Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Human readable text label with content meaningful to human operators.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="SubsystemStateEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the overall status/state of the Subsystem.  See enumeration annotations for further details.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>Indicates the subsystem is in an unknown state.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NOT_INSTALLED">
				<xs:annotation>
					<xs:documentation>Indicates the subsystem is not installed.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OFF">
				<xs:annotation>
					<xs:documentation>Indicates the subsystem is in an OFF state as it was not powered up.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PRE_INITIALIZATION">
				<xs:annotation>
					<xs:documentation>Indicates the subsystem is performing their bootstrap and initial OFP load.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INITIALIZATION">
				<xs:annotation>
					<xs:documentation>Indicates the subsystem is performing its initialization and mission data load.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="STANDBY">
				<xs:annotation>
					<xs:documentation>Indicates the subsystem has completed its initialization and is ready to transition to the operation state.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OPERATE">
				<xs:annotation>
					<xs:documentation>Indicates the subsystem is allowed to perform its enabled capabilities.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OPERATE_RX_ONLY">
				<xs:annotation>
					<xs:documentation>Indicates the subsystem is allowed to perform its enabled receive only capabilities.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OPERATE_TX_ONLY">
				<xs:annotation>
					<xs:documentation>Indicates the subsystem is allowed to perform its enabled transmit only capabilities.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MAINTENANCE">
				<xs:annotation>
					<xs:documentation>Indicates the subsystem is performing or has performed its maintenance procedure.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CALIBRATION">
				<xs:annotation>
					<xs:documentation>Indicates the Subsystem state of calibration.  This form of calibration is initiated via SubsystemStateCommand and interrupts other functions.  Some Subsystems support a form of calibration that is initiated via SubsystemBIT_Command, doesn't require a Subsystem state change and doesn't interrupt other Subsystem functions.  See SubsystemCalibrationConfiguration for further details regarding the difference between types of commanded/initiated calibration.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INITIATED_BIT">
				<xs:annotation>
					<xs:documentation>Indicates the Subsystem state of Initiated Built In Test (BIT).  This form of initiated BIT is initiated via SubsystemStateCommand and interrupts other functions.  Some Subsystems support a form of initiated BIT that is initiated via SubsystemBIT_Command, doesn't require a Subsystem state change and doesn't interrupt other Subsystem functions.  See SubsystemBIT_Configuration for further details regarding the difference between types of commanded/initiated BIT.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SHUTDOWN">
				<xs:annotation>
					<xs:documentation>Indicates the subsystem is performing or has performed its shutdown procedure. Once complete, no messages will be sent by the subsystem.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEGRADED">
				<xs:annotation>
					<xs:documentation>A subsystem is considered degraded when a non-critical anomaly is encountered restricting the subsystem from performing the mission in its entirety but is still able to perform at least one use case within the mission.  The following is a non-exhaustive list of examples that could cause a subsystem to enter a DEGRADED state;
   - Redundant component failed but subsystem is still operational.
   - Decline in quality of service and/or functionality.
   - Mismatch of discretes.
   - Subset of components has failed however, functionality is still available.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="SubsystemStatusMDT" uci:version="001.000.003.002">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SubsystemID" type="uci:SubsystemID_Type">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the Subsystem whose status is given in the message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubsystemState" type="uci:SubsystemStateEnum">
				<xs:annotation>
					<xs:documentation>Indicates the current state of the Subsystem.  The state machine and allowable transitions for Subsystem states is described in supporting documentation.  A given Subsystem might not support all states.  Subsystem state can be controlled via SubsystemStateCommand, discrete/special signals and/or other means.  See enumeration annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubsystemStateDescription" type="uci:VisibleString256Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element is intended to provide a human readable, supplemental description of the sibling SubsystemState.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EnabledSetting" type="uci:SubsystemEnabledSettingType" minOccurs="0" maxOccurs="8">
				<xs:annotation>
					<xs:documentation>Indicates a Subsystem setting that is currently enabled.  Settings are enabled/disabled via the SubsystemSettingsCommand.  See SubsystemSettingEnum for further details.  If multiple instances are given, each should be of a different setting type as indicated by the child element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CommandableSubsystemSettingParameters" type="uci:SubsystemSupportedSettingType" minOccurs="0" maxOccurs="8">
				<xs:annotation>
					<xs:documentation>SettingParameters identified here indicate the SettingParameters specified in the SubsystemConfiguration message that are commandable at this point in time.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EraseStatus" type="uci:ProcessingStatusEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates status of erase of the Subsystem.  Erase can be controlled via SubsystemEraseCommand, discrete/special signals and/or other means.  If omitted, erase is not active.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StateTransitionStatus" type="uci:StateTransitionStatusEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates whether or not the Subsystem is transitioning between states, or transitioning to its SHUTDOWN state.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CommandableSubsystemState" type="uci:SubsystemStateEnum" minOccurs="0" maxOccurs="14">
				<xs:annotation>
					<xs:documentation>Indicates the possible state or states the Subsystem can be commanded to transition into from its current state.  This is not intended to replace the service contract but is intended to be used to advertise state transitions that change depending on things such as the altitude an aircraft is at. For example, a subsystem on an aircraft is not able to transition to state X until it reaches 30K ft., something that is difficult/impossible to do with a service contract. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="About" type="uci:AboutType">
				<xs:annotation>
					<xs:documentation>Indicates version numbers associated with the Subsystem and its software and hardware.  More details on the Subsystem's configuration are provided in the SubsystemConfiguration message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ExtendedStatus" type="uci:SubsystemExtendedStatusPET" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element is an abstract extension to provide Subsystem Specific Status.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubsystemComponent" type="uci:ComponentType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an auxiliary or subordinate Component of this Subsystem.  Components can be physical or functional.  Any Component that is relevant to the state, health and/or C2 of the Subsystem can be reported.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SubsystemStatusMT" uci:version="002.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:SubsystemStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SubsystemSupportedSettingType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SubsystemSetting" type="uci:SubsystemSettingEnum">
				<xs:annotation>
					<xs:documentation>Indicates a general UCI Subsystem level setting supported by the Subsystem, commandable via SubsystemSettingsCommand.  See enumeration annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SettingParameter" type="uci:SubsystemSettingParameterType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a Subsystem defined/unique amplifying "parameter" of the sibling SubsystemSetting that is supported.  A parameter is flexible abstraction that might indicate a "level" or other granular means of controlling/configuring a Subsystem setting (SubsystemSettingEnum) to meet the unique needs of a specific Subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SurfaceRecoveryType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Describes the status and approach condition of a flight deck.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="FlightDeckStatus" type="uci:FlightDeckStatusEnum">
				<xs:annotation>
					<xs:documentation>Indicates the status of a flight deck. For example, see MIL-STD-6016 DFI 878 DUI 001.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ApproachConditionStatus" type="uci:ApproachConditionStatusEnum">
				<xs:annotation>
					<xs:documentation>Indicates the meteorological condition of the approach and recovery route to the flight deck. For example, see MIL-STD-6016 DFI 1545 DUI 001.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SystemCommunicationsType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="MissionCommunicationsState" type="uci:MissionCommunicationsStateEnum">
				<xs:annotation>
					<xs:documentation>This element specifies the state of communications between a system and its controlling system.  In the case of a vehicle, this would be the state of communication between the vehicle and the ground station.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CommTimeout" type="uci:DurationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Duration after which, if the position report has not been received, it is assumed that communication has been lost.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PrePlannedCommReturnTime" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element is used to indicate when a vehicle will regain communications during a preplanned communications outage.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CommUsage" type="uci:CommSystemUsageType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element represents a specific communication system that this system utilizes for operations. This information is used to ensure sufficient communications have been acquired and are ready to be used in addition to deconflicting with other systems which may utilize the same communications system.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="SystemContingencyLevelEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Designates the contingency state of the System.  Contingencies can be an indication that the System will/has automatically modified its means of navigation.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="NORMAL">
				<xs:annotation>
					<xs:documentation>Indicates that the vehicle is operating normally.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MISSION_CRITICAL">
				<xs:annotation>
					<xs:documentation>Indicates a mission critical level of contingency. Possible causes include failure of one or more subsystems, mission avionics failure, etc.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FLIGHT_CRITICAL">
				<xs:annotation>
					<xs:documentation>Indicates a flight critical level of contingency. Possible causes include critically low fuel state, excessive icing, problems with control surface actuation, physical damage, failure of flight critical avionics, etc.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LOST_COMMS">
				<xs:annotation>
					<xs:documentation>Indicates the vehicle has lost communication with its controlling system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="SystemID_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>The ID type that refers to an aggregation of Subsystems.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SystemIdentityType" uci:version="003.001.003.001">
		<xs:annotation>
			<xs:documentation>SystemIdentityType is an extension of IdentityType to include additional information specifically relevant to the identity of a system.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:IdentityType">
				<xs:sequence>
					<xs:element name="QualifyingTags" type="uci:QualifyingTagsType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Provides identity qualifications to augment identification and associated processing of the System.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="AssociatedTime" type="uci:TimeFunctionType" minOccurs="0" maxOccurs="12">
						<xs:annotation>
							<xs:documentation>Indicates time related events that are associated to the system such as when operational or arriving at a destination. The multiplicity is limited to N-1 options where NONE is an event that has no value, thus removed from list of available options.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SystemMessageIdentifierType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Identifies a system and service as an object in a message.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>The system that should process a message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ServiceID" type="uci:ServiceID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The specific service in the System that should process a message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActivityID" type="uci:ActivityID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The activity that should handle this message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NetworkLinkID" type="uci:NetworkLinkID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The network link that should handle this message.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="SystemSourceEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Defines whether the associated data was generated from actual system data or an estimation service.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ACTUAL">
				<xs:annotation>
					<xs:documentation>Indicates the data is being reported by a system or its surrogate.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ESTIMATED">
				<xs:annotation>
					<xs:documentation>Indicates the data is an estimate.  For example, if the system's actual data isn't available due to a comms outage then the data could be estimated based on the system's last known plan.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OVERRIDE">
				<xs:annotation>
					<xs:documentation>Indicates the data is a partial or complete override of values reported by the system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SystemStateEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Represents the operational state of the system with respect to active mission activities.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="OPERATIONAL">
				<xs:annotation>
					<xs:documentation>OPERATIONAL indicates the system is currently active, communicating, and functioning properly.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEGRADED">
				<xs:annotation>
					<xs:documentation>DEGRADED indicates that there is some segment of system capability that is no longer functional but some ability to process mission tasks remains.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FAILED">
				<xs:annotation>
					<xs:documentation>FAILED indicates that the system can no longer process any mission functions.  The system is either returning to base or has been lost.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INACTIVE">
				<xs:annotation>
					<xs:documentation>INACTIVE is used when a system is coming online but has not yet begun to communicate, when it has ended its mission and is no longer available to be tasked, or when this message is being used for maintenance and platform-logistics purposes outside of operations.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="SystemStatusMDT" uci:version="003.000.003.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>Identifier that refers to any level of control station or a vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SystemState" type="uci:SystemStateEnum">
				<xs:annotation>
					<xs:documentation>This element represents the operational state of the system with respect to active mission activities.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Source" type="uci:SystemSourceEnum">
				<xs:annotation>
					<xs:documentation>Indicates the source of the data in sibling elements.  See enumeration annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FusionEligibility" type="uci:EntityFusionEligibilityEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the eligibility of this Entity for automated fusion operations by the Entity's source System/Service and/or fusion tier.  FULL indicates that this Entity, and therefore its contributor Entity or Entities, is fully eligible for future automated fusion operations.  SELECTIVE_EXCLUSION indicates that the Entity is eligible for future automated fusion operations excluding merging with the Entity or Entities given in the sibling CorrelatedEntity element.  SELECTIVE_INCLUSION indicates that the Entity is eligible for future automated fusion operations but only with the Entity or Entities given in the sibling CorrelatedEntity element.  NONE indicates that this Entity is not eligible for future automated fusion operations regardless of the associated Entity.  This element does not restrict operator initiated fusion operations via the EntityManagementRequest.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Model" type="uci:VisibleString32Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Identifies resource manufacturer and model.   This element can serve as means to "look-up" a description or model of the System that is described independent of UCI.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Identity" type="uci:SystemIdentityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents the mission/functional identity of the System. It is left to applications using UCI to enforce compatibility with the portions of MIL-STD-6016 or other standards referenced herein.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Communications" type="uci:SystemCommunicationsType">
				<xs:annotation>
					<xs:documentation>Indicates the communication state and usage information for this system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OperatorID" type="uci:OperatorID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The UUID of the operator associated with this system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubsystemID" type="uci:SubsystemID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a C2 relevant Subsystem of the System.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CapabilityID" type="uci:CapabilityID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a C2 relevant Capability of the System.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ServiceID" type="uci:ServiceID_Type" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a Service that is implemented by the System.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlatformStatus" type="uci:PlatformStatusType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>General status information about the asset.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VoiceControl" type="uci:VoiceControlType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This type contains the connection data needed to communicate with a vehicle using voice radios.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ActivityBy" type="uci:ActivityByType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>This element indicates an activity, that isn't otherwise represented by UCI Tasks, Capability commands, etc. being performed by the Entity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Strength" type="uci:StrengthType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The number of entities represented by a single track.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SystemStatusMT" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>See the annotation in the associated message for an overall description of the message and this type.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:MessageType">
				<xs:sequence>
					<xs:element name="MessageData" type="uci:SystemStatusMDT">
						<xs:annotation>
							<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:simpleType name="TailNumberType" uci:version="000.002.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the vehicle's tail number.  Typically used for aircraft vehicles.  DoD aircraft are identified by a five-digit tail number. For most military aircraft, the first two digits of the tail number are the fiscal year that the aircraft was ordered, and the remaining digits are the last three digits of the airframe's serial number. US Civil aircraft are identified by a two to six character alphanumeric registration number assigned by the ICAO or FAA. International tail numbers (registrations) follow similar patterns, but may be up to 10 characters long, often containing a dash separating the country code from the specific alphanumeric registration.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="2" />
			<xs:maxLength value="10" />
			<xs:pattern value="[A-Z0-9\-]{2,10}" />
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="TaskID_Type" uci:version="001.001.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that correspond to Tasks.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:VersionedID_Type" />
		</xs:complexContent>
	</xs:complexType>
	<xs:simpleType name="TemperatureStateEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicate the temperature status for a subsystem or subsystem component.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="UNDER_TEMP">
				<xs:annotation>
					<xs:documentation>Component temperature is below the normal operating range.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NORMAL">
				<xs:annotation>
					<xs:documentation>Component temperature is in the normal operating range.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OVER_TEMP_WARNING">
				<xs:annotation>
					<xs:documentation>Component temperature is higher than the normal operating range but has not yet affected component operation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OVER_TEMP_DEGRADED">
				<xs:annotation>
					<xs:documentation>Component is operating in a degraded mode due to high component temperature.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OVER_TEMP_SHUTDOWN">
				<xs:annotation>
					<xs:documentation>Component has shut down due to high component temperature.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="TemperatureStatusType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Temperature" type="uci:TemperatureType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The temperature of the component.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TemperatureState" type="uci:TemperatureStateEnum" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the temperature status for a subsystem or subsystem component.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="TemperatureType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates temperature in degrees Celsius (C).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:double" />
	</xs:simpleType>
	<xs:simpleType name="ThreatEnum" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>Indicates the type of threat. Enum members have been sourced largely from MIL-STD-6016 Threat Type. Some members have been added specifically for UCI.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AIR_TO_SURFACE_MISSILE">
				<xs:annotation>
					<xs:documentation>Missile designed to be launched from military aircraft at targets on land or sea.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="AIR_TO_AIR_MISSILE">
				<xs:annotation>
					<xs:documentation>Missile fired from an aircraft for the purpose of destroying another aircraft.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SURFACE_TO_SURFACE_MISSILE">
				<xs:annotation>
					<xs:documentation>Missile designed to be launched from the ground or the sea and strike targets on land or at sea.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SURFACE_TO_AIR_MISSILE">
				<xs:annotation>
					<xs:documentation>Missile designed to be launched from the ground to destroy aircraft or other missiles.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ANTISHIP_CRUISE_MISSILE">
				<xs:annotation>
					<xs:documentation>Missile designed for use against ships and large boats.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MISSILE">
				<xs:annotation>
					<xs:documentation>Missile of undetermined type.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ANTIAIRCRAFT_ARTILLERY">
				<xs:annotation>
					<xs:documentation>Weapons designed to attack aircraft that commonly have a high rate of fire and are able to fire shells designed to damage aircraft.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TORPEDO">
				<xs:annotation>
					<xs:documentation>Self-propelled weapon with an explosive warhead, launched above or below the water surface, propelled underwater towards a target.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="JAMMER">
				<xs:annotation>
					<xs:documentation>Weapon that interferes with the operation of a radar by saturating its receiver with noise or false information.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="IMPROVISED_EXPLOSIVE_DEVICE">
