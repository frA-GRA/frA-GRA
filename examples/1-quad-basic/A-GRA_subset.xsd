				<xs:annotation>
					<xs:documentation>This element represents the length of the semi-major axis.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SemiMinorAxisLength" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>This element represents the length of the semi-minor axis.</xs:documentation>
