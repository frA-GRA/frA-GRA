	<xs:simpleType name="OrbitClassEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the class of an orbit regime and are secondary descriptions of orbits within a regime.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="CIRCULAR">
				<xs:annotation>
					<xs:documentation>An orbit whose eccentricity is less than or equal to 0.005.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ELLIPTICAL">
				<xs:annotation>
					<xs:documentation>An orbit whose eccentricity is greater than 0.005 and less than or equal to 0.25.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HIGHLY_ELLIPTICAL">
				<xs:annotation>
					<xs:documentation>An orbit whose eccentricity is greater than 0.25 and less than 1.0.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PARABOLIC">
				<xs:annotation>
					<xs:documentation>An orbit whose eccentricity is exactly 1.0.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HYPERBOLIC">
				<xs:annotation>
					<xs:documentation>An orbit whose eccentricity is greater than 1.0.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUN_SYNCHRONOUS">
				<xs:annotation>
					<xs:documentation>An orbit where the orbit normal vector of the spacecraft is always oriented toward the Sun.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="POLAR">
				<xs:annotation>
					<xs:documentation>An orbit that passes directly over the North and South Poles of the central body. The inclination is 90 degrees +/- 5 degrees.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RETROGRADE">
				<xs:annotation>
					<xs:documentation>An orbit whose inclination is greater than 90 degrees.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEMI_SYNCHRONOUS">
				<xs:annotation>
					<xs:documentation>An orbit whose orbit period is roughly half of the length of time of a sideral day of the central body.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EARTH_MOON_L1">
				<xs:annotation>
					<xs:documentation>An orbit at the L1 Lagrange point for the Earth-Moon-space object system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EARTH_MOON_L2">
				<xs:annotation>
					<xs:documentation>An orbit at the L2 Lagrange point for the Earth-Moon-space object system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EARTH_MOON_L3">
				<xs:annotation>
					<xs:documentation>An orbit at the L3 Lagrange point for the Earth-Moon-space object system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EARTH_MOON_L4">
				<xs:annotation>
					<xs:documentation>An orbit at the L4 Lagrange point for the Earth-Moon-space object system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="EARTH_MOON_L5">
				<xs:annotation>
					<xs:documentation>An orbit at the L5 Lagrange point for the Earth-Moon-space object system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUN_EARTH_L1">
				<xs:annotation>
					<xs:documentation>An orbit at the L1 Lagrange point for the Sun-Earth-space object system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUN_EARTH_L2">
				<xs:annotation>
					<xs:documentation>An orbit at the L2 Lagrange point for the Sun-Earth-space object system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUN_EARTH_L3">
				<xs:annotation>
					<xs:documentation>An orbit at the L3 Lagrange point for the Sun-Earth-space object system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUN_EARTH_L4">
				<xs:annotation>
					<xs:documentation>An orbit at the L4 Lagrange point for the Sun-Earth-space object system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUN_EARTH_L5">
				<xs:annotation>
					<xs:documentation>An orbit at the L5 Lagrange point for the Sun-Earth-space object system.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MOLNIYA">
				<xs:annotation>
					<xs:documentation>A special case of a highly elliptical orbit with an inclination of 63.4 degrees (or 116.6 deg for Southern hemisphere apogee), an argument of perigee of 270 deg (or 90 deg for Southern hemisphere apogee), an eccentricity of about 0.74, and an orbit period of about 12 hours.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>An unknown or unidentified orbit.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OTHER">
				<xs:annotation>
					<xs:documentation>An exquisite orbit that does not fit any of the other specified orbit classes.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="OrbitDurationType" uci:version="000.000.000.000">
