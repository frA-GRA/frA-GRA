			<xs:minLength value="1"/>
			<xs:maxLength value="100"/>
			<xs:pattern value="[A-Z_0-9\-]{1,100}">
				<xs:annotation>
					<xs:documentation>SPECIAL ACCESS REQUIRED-XXX,Within the nickname or name of a SAR all spaces must be replaced with a "_". The XSL will restore the spaces for rendering.</xs:documentation>
				</xs:annotation>
			</xs:pattern>
			<xs:pattern value="[A-Z]{2,100}">
				<xs:annotation>
					<xs:documentation>SPECIAL ACCESS REQUIRED-XXX, the Digraph or Trigraph of the SAR is represented by the XXX</xs:documentation>
				</xs:annotation>
			</xs:pattern>
			<xs:pattern value="[A-Z]{2,}-[A-Z][A-Z0-9]+">
				<xs:annotation>
					<xs:documentation>SPECIAL ACCESS REQUIRED-XXX, the Digraph or Trigraph of the SAR is represented by the XXX</xs:documentation>
				</xs:annotation>
			</xs:pattern>
			<xs:pattern value="[A-Z]{2,}-[A-Z][A-Z0-9]+-[A-Z0-9]{2,}">
				<xs:annotation>
					<xs:documentation>SPECIAL ACCESS REQUIRED-XXX, the Digraph or Trigraph of the SAR is represented by the XXX</xs:documentation>
				</xs:annotation>
			</xs:pattern>
		</xs:restriction>
	</xs:simpleType>
