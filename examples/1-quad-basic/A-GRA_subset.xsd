				</xs:annotation>
			</xs:element>
			<xs:element name="MDF_SubCategoryFileID" type="uci:MDF_SubCategoryFileID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the unique ID of the MDF subcategory file being referenced.  Required when the referenced MDF referenced by the sibling MDF_ID is decomposed into individually selectable subcategory files.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MDF_ItemIndex" type="uci:ForeignKeyType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates the index of a specific item within the referenced MDF or MDF subcategory file.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MDF_StatusType" uci:version="000.000.000.000">
