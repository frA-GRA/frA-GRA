			<xs:enumeration value="LESOTHO">
				<xs:annotation>
					<xs:documentation>Lesotho, a high-altitude, landlocked kingdom encircled by South Africa, is crisscrossed by a network of rivers and mountain ranges including the 3,482m-high peak of Thabana Ntlenyana.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LIBERIA">
