	</xs:complexType>
	<xs:complexType name="EmitterIdentityCategoryType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the emitter identification based on its category.</xs:documentation>
		</xs:annotation>
