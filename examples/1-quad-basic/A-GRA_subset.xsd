				</xs:annotation>
			</xs:element>
			<xs:element name="AltitudeError" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Altitude error of flight path measured in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
