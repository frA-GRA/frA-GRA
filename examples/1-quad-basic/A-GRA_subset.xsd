	<xs:complexType name="VehicleIdentificationType" uci:version="003.001.001.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SystemID" type="uci:SystemID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the UCI SystemID of the asset.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VehicleUniqueIdentifier" type="uci:VehicleUniqueIdentifierType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Unique identifier for the vehicle. This will differ depending on the type of vehicle. Air platforms will have a Tail Number. Space assets will have a Sat ID. Maritime (ships and subs) will have Hull Numbers.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IFF" type="uci:IFF_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates Identify Friend or Foe (IFF) modes and settings for the asset.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CallSign" type="uci:CallSignType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a call sign for the asset.  Multiple call signs are allowed for different communications systems, registries or other reasons.  The use of ForeignKeyType is an indication that call signs aren't universally defined and come from multiple systems/sources but they are expected to be unique within the context of their source.  The child Key element indicates the call sign itself while the child SystemName element indicates the system that assigned it and ensures it is unique.  Call signs from ubiquitous systems/sources such as AIS are given in sibling elements and shouldn't be repeated here.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RadarCrossSection" type="uci:ForeignKeyType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The specific Radar Cross Section identification for this system.  This will typically be a system-specific and service-specific identifier for pre-configured Radar Cross Sectional data.  Services should have coordinated this data ahead of time.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DataLinkIdentifier" type="uci:DataLinkIdentifierPET" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>List of data link ID. Multiple data link IDs can be reported for the same network type.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VehicleUniqueIdentifierType" uci:version="003.000.001.000">
		<xs:annotation>
			<xs:documentation>Unique identifier for a vehicle. This will differ depending on the type of vehicle. Air platforms will have a Tail Number. Space assets will have a Sat ID. Ships and Subs will have AIS Numbers.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="AIS" type="uci:AIS_Type">
				<xs:annotation>
					<xs:documentation>Indicates select maritime Automatic Identification System (AIS) settings for the asset/vessel.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TailNumber" type="uci:TailNumberType">
				<xs:annotation>
					<xs:documentation>Unique identifier for air platforms.  See type annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Satellite" type="uci:SatelliteIdentifierType">
				<xs:annotation>
					<xs:documentation>The Satellite Identifier used to identify a Satellite.  See type annotations for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AlternateIdentifier" type="uci:AlphanumericDashSpaceUnderscoreString20Type">
				<xs:annotation>
					<xs:documentation>Unique identifier that does not fall into any of the other categories. e.g. A Land based vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="Velocity2D_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Velocity relative to WGS-84 ellipsoid.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="NorthSpeed" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>The speed component along the true north vector in meters/sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EastSpeed" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>The speed component along the true east vector in meters/sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DownSpeed" type="uci:SpeedType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Inertial vertical speed component pointing down measured in meters/sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Timestamp" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the time when the velocity data was measured or last known to be correct.  The element can also indicate the time at which a future velocity of a System, Entity, etc. will be achieved.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Velocity3D_Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Velocity relative to WGS-84 ellipsoid.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="NorthSpeed" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>The speed component along the true north vector in meters/sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EastSpeed" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>The speed component along the true east vector in meters/sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DownSpeed" type="uci:SpeedType">
				<xs:annotation>
					<xs:documentation>Inertial vertical speed component pointing down measured in meters/sec.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Timestamp" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the time when the velocity data was measured or last known to be correct.  The element can also indicate the time at which a future velocity of a System, Entity, etc. will be achieved.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="VersionedID_Type" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>The ID type for UCI IDs that use versioning.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="uci:ID_Type">
				<xs:sequence>
					<xs:element name="Version" type="xs:unsignedInt" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Indicates an incremental version of an item in which only minor changes have been made.  An example of a change that would require a new UUID and not just a new version would be for changes that affect task allocations or changes that require re-approval.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:simpleType name="VisibleString1024Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>String type of 1024 characters in length, restricted to visible characters (0x20-0x7E).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="0" />
			<xs:maxLength value="1024" />
			<xs:pattern value="[ -~]{0,1024}" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="VisibleString128Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>String type of 128 characters in length, restricted to visible characters (0x20-0x7E).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="0" />
			<xs:maxLength value="128" />
			<xs:pattern value="[ -~]{0,128}" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="VisibleString256Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>String type of 256 characters in length, restricted to visible characters (0x20-0x7E).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="0" />
			<xs:maxLength value="256" />
			<xs:pattern value="[ -~]{0,256}" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="VisibleString32Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>String type of 32 characters in length, restricted to visible characters (0x20-0x7E).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="0" />
			<xs:maxLength value="32" />
			<xs:pattern value="[ -~]{0,32}" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="VisibleString64Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>String type of 64 characters in length, restricted to visible characters (0x20-0x7E).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="0" />
			<xs:maxLength value="64" />
			<xs:pattern value="[ -~]{0,64}" />
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="VoiceControlType" uci:version="001.001.000.000">
		<xs:annotation>
			<xs:documentation>This type contains the connection data needed to communicate with a vehicle using voice radios.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="VoiceFrequency" type="uci:FrequencyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Frequency between 225 to 400 MHz.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VoiceChannelA" type="uci:Link16_VoiceChannelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Prearranged channel number between 0-127.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VoiceChannelB" type="uci:Link16_VoiceChannelType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Prearranged channel number between 0-127.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="WayPointPointChoiceType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>Location associated with the specified waypoint expressed as either a geospatial or relative point.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Point2D" type="uci:Point2D_Type">
				<xs:annotation>
					<xs:documentation>Indicates the geospatial point corresponding to the waypoint.  Generally, services are encouraged to send altitude and/or time data whenever it is known.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RelativePoint" type="uci:Point2D_RelativeType">
				<xs:annotation>
					<xs:documentation>Indicates the Relative point corresponding to the waypoint.  Generally, services are encouraged to send altitude data whenever it is known.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="WayPointType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>This element is used to specify a point in the route where no turning occurs.  It is generally used for points associated with Actions such as task "transitions", changes in acceleration, changes in speed, changes in altitude, etc.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PointChoice" type="uci:WayPointPointChoiceType">
				<xs:annotation>
					<xs:documentation>Location associated with the specified waypoint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WaypointType" type="uci:WaypointTypeEnum">
				<xs:annotation>
					<xs:documentation>Indicates the action associated with the specified waypoint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DMPI_PointID" type="uci:DMPI_ID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates that this point is the final point in a weapon route with the weapon expecting to impact at the DMPI specified.  The last waypoint of a weapon route may be the terminal guidance entry point.  In this case, the waypoint specified may not be the same as the DMPIs location.  It is the point of entrance into terminal guidance of the weapon.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="WaypointTypeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the action associated with the specified waypoint.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="NAV_ONLY">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint does not have an additional action associated with it beyond navigation.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TAXI">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is part of a taxi route.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RUNWAY_START">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is at the start of a runway.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RUNWAY_THRESHOLD">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is at the nearest point of the runway.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RUNWAY_LIMIT">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is at the furthest point of the runway.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="APPROACH">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is part of an approach to an airstrip.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="APPROACH_INITIAL_POINT">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is the initial point of an approach to an airstrip.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="APPROACH_FINAL_POINT">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is the final point of an approach to an airstrip.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TAKEOFF">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is part of a takeoff action.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TAKEOFF_INITIAL_POINT">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is the initial point of a takeoff action.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TAKEOFF_FINAL_POINT">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is the final point of a takeoff action.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TOUCHDOWN">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is at the desired point of touchdown.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="PASSIVE">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="HARD_DITCH">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is the point at which a hard ditch of the vehicle will be performed.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="END_OF_PATH">
				<xs:annotation>
					<xs:documentation>Indicates the waypoint is the end of the specified path.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="WhitespaceVisibleString1024Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>String type of 1024 characters in length, restricted to visible characters (0x21-0x7E) and whitespace characters.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="0"/>
			<xs:maxLength value="1024"/>
			<xs:whiteSpace value="collapse"/>
			<xs:pattern value="[\s&#x21;-&#x7E;]{0,1024}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="WhitespaceVisibleString4096Type" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>String type of 4096 characters in length, restricted to visible characters (0x21-0x7E) and whitespace characters.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="0"/>
			<xs:maxLength value="4096"/>
			<xs:whiteSpace value="collapse"/>
			<xs:pattern value="[\s&#x21;-&#x7E;]{0,4096}"/>
		</xs:restriction>
	</xs:simpleType>
	<!--== END SUPPORTING SIMPLE TYPES  ==-->
	<xs:complexType name="Z_ChoiceType" uci:version="001.001.001.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Z" type="uci:DistanceOffsetType">
				<xs:annotation>
					<xs:documentation>Offset in the Z direction from the reference frame origin. Down is positive.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AltitudeOffset" type="uci:AltitudeOffsetReferenceType">
				<xs:annotation>
					<xs:documentation>Offset in the Z direction is considered an altitude difference with positive values corresponding to increases in altitude.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AbsoluteAltitude" type="uci:AltitudeReferenceType">
				<xs:annotation>
					<xs:documentation>Optional choice to use Absolute Altitude per altitude reference instead of a vertical offset from the reference frame origin.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
</xs:schema>
