				</xs:annotation>
			</xs:element>
			<xs:element name="Radius" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>The radius of a circle in meters.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
