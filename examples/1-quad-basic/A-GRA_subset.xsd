			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:simpleType name="OrbitEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>An enumeration specifying the type of orbit.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="CIRCLE">
				<xs:annotation>
					<xs:documentation>Specifies the orbit should be circular or elliptical.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="RACETRACK">
				<xs:annotation>
					<xs:documentation>Specifies the orbit should be a racetrack, two semicircles connected by straight lines.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FIGURE_EIGHT">
				<xs:annotation>
					<xs:documentation>Specifies the orbit should be a figure eight.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OrbitRegimeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the name of an orbit regime which are mostly altitude-based and are in line with traditional terminology (e.g., LEO, MEO, and GEO).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="LEO">
				<xs:annotation>
					<xs:documentation>Low Earth Orbit. An Earth-centered orbit whose apogee altitude is greater than or equal to 160 km and less than 2000 km.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="MEO">
				<xs:annotation>
					<xs:documentation>Medium Earth Orbit. An Earth-centered orbit whose apogee altitude is greater than or equal to 2000 km and less than 35,786 km.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GEO">
				<xs:annotation>
					<xs:documentation>Geosynchronous Orbit. An Earth-centered orbit whose perigee and apogee altitudes are both 35,786 km +/- 100 km.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GSO">
				<xs:annotation>
					<xs:documentation>Geostationary Orbit. An Earth-centered orbit that is a special case of a GEO where the inclination is less than 1 degree or greater than 179 degrees so that the object remains approximately over the same point on Earth throughout its orbit.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SUPER_SYNCHRONOUS_GEO">
				<xs:annotation>
					<xs:documentation>Super-synchronous GEO. An Earth-centered orbit whose apogee altitude is greater than 35,786 km and whose perigee altitude is less than 35,786 km.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CISLUNAR">
				<xs:annotation>
					<xs:documentation>An Earth-centered orbit whose apogee radius is less than 385,000 km (about 60 Earth radii) and whose perigee radius is greater than 42,164 km.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GTO">
				<xs:annotation>
					<xs:documentation>Geosynchronous Transfer Orbit. An elliptical Earth-centered orbit whose apogee altitude is near 35,786 km (within 100 km).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LUNAR">
				<xs:annotation>
					<xs:documentation>A Moon-centered orbit.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INTERPLANETARY">
				<xs:annotation>
					<xs:documentation>A Sun-centered orbit.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INTERSTELLAR">
				<xs:annotation>
					<xs:documentation>An orbit beyond the gravitational influence of the Sun.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>An unknown or unidentified orbit.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="OrbitRegimeType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the orbit characteristics of a space object.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="OrbitRegime" type="uci:OrbitRegimeEnum">
				<xs:annotation>
					<xs:documentation>Orbit regime of a space object.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrbitClass" type="uci:OrbitClassEnum" minOccurs="0" maxOccurs="22">
				<xs:annotation>
					<xs:documentation>Orbit class of space object, a space object can have multiple orbit classes. List size for this element is based on "Select All That Apply" condition.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrbitType" uci:version="002.000.002.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="OrbitType" type="uci:OrbitEnum">
				<xs:annotation>
					<xs:documentation>What flight pattern this orbit will take.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Circle" type="uci:CircleType" maxOccurs="2">
				<xs:annotation>
					<xs:documentation>A single point will be provided if and only if OrbitType is Circle. See annotations of each OrbitType (OrbitEnum) value for further details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TurnDirection" type="uci:RelativeDirectionEnum">
				<xs:annotation>
					<xs:documentation>Direction of turn when rounding the first loiter point.  For a figure 8, this direction applies to the first of the two Circle elements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Duration" type="uci:OrbitDurationType">
				<xs:annotation>
					<xs:documentation>Duration for the orbit as either a required time spent in the orbit pattern or the number of orbits to make around the pattern.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrientationRateType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the rate of change of the orientation.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="YawRate" type="uci:AngleRateType">
				<xs:annotation>
					<xs:documentation>Indicates the rate of change of the Yaw.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PitchRate" type="uci:AngleRateType">
				<xs:annotation>
					<xs:documentation>Indicates the rate of change of the Pitch.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RollRate" type="uci:AngleRateType">
				<xs:annotation>
					<xs:documentation>Indicates the rate of change of the Roll.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Timestamp" type="uci:DateTimeType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the date and time, in Zulu format, at which the orientation rate data was measured, last known to be correct and/or predicted to occur.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrientationType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>Euler Angle Sequence describing the orientation of the vehicle in the order yaw, pitch, roll.  The angles are given in a locally level, North-East-Down coordinate system centered on the vehicle.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Yaw" type="uci:AngleType">
				<xs:annotation>
					<xs:documentation>Angle in radians representing the vehicle's rotation about the vertical axis (the axis from top to bottom through the aircraft) in a locally level, North-East-Down coordinate system centered on the vehicle.  By this definition, Yaw is zero when the aircraft is oriented toward true North and is equivalent to true North referenced heading.</xs:documentation>
				</xs:annotation>
			</xs:element>
