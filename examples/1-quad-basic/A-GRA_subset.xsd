	</xs:complexType>
	<xs:complexType name="EmitterIdentityType" uci:version="000.001.000.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="EmitterCategory" type="uci:EmitterIdentityCategoryType">
				<xs:annotation>
					<xs:documentation>Indicates the emitter identification based on its category.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NATO_SpotNumber" type="uci:OctalValueType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The octal digits representing the NATO spot number.  The NATO spot number is used in specific emitter identification.  It is used in Link 16 and other standards which may have differing range limits between versions.  The user is responsible for adhering to the allowed range on their implementation.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="EmptyType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>An empty, blank type used to indicate that no further content is expected.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:length value="0" />
			<xs:pattern value="[A-Za-z]{0}" />
