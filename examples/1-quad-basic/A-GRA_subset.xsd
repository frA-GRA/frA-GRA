				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LIBYA">
				<xs:annotation>
					<xs:documentation>Libya, officially the State of Libya, is a country in the Maghreb region in North Africa bordered by the Mediterranean Sea to the north, Egypt to the east, Sudan to the southeast, Chad to the south, Niger to the southwest, Algeria to the west, Tunisia to the northwest, and maritime borders with Malta and Greece.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="LIECHTENSTEIN">
