				<xs:annotation>
					<xs:documentation>UUID of the reference frame object that this offset applies to.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Vertex" type="uci:RelativeOffset2D_Type" minOccurs="3" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A relative polygon has a minimum of 3 vertices relative to the reference frame origin.  All points in the list are relative to the reference frame origin, i.e. none of the points is assumed to be the reference point or origin of the reference frame.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
