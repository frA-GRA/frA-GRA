	<xs:simpleType name="ComponentElementStateEnum" uci:version="000.000.000.001">
		<xs:annotation>
			<xs:documentation>Indicates the state a component element that may not be part of a Subsystem.  See enumeration annotations for further details.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>Indicates this component state is unknown.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="NOT_INSTALLED">
				<xs:annotation>
					<xs:documentation>Indicates this component is not installed.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OFF">
				<xs:annotation>
					<xs:documentation>Indicates this component is installed, but not powered on.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INITIALIZING">
				<xs:annotation>
					<xs:documentation>Indicates this component has been turned on and is initializing its hardware components or software elements.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OPERATIONAL">
				<xs:annotation>
					<xs:documentation>Indicates this component is operational and able to perform its functions.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DEGRADED">
				<xs:annotation>
					<xs:documentation>Indicates this component is degraded but is still able to support at least one function.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DISABLED">
				<xs:annotation>
					<xs:documentation>Indicates this component is not enabled to perform its functions or has been disabled for some reason.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FAULTED">
				<xs:annotation>
					<xs:documentation>Indicates this component has faulted and is incapable of supporting any functions.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ACTIVE">
				<xs:annotation>
					<xs:documentation>Indicates the component is active.  Intended for components that are outside of the typical UCI Capability and may be on the flight side.  This state can be for electrical components to report if they are currently active.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INACTIVE">
				<xs:annotation>
					<xs:documentation>Indicates the component is inactive.  Intended for components that are outside of the typical UCI Capability and may be on the flight side. This state can be for electrical components to report if they are currently inactive.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ENGAGED">
				<xs:annotation>
					<xs:documentation>Indicates the component is engaged.  Intended for components that are outside of the typical UCI Capability and may be on the flight side.  This state can be for components such as brakes that report engaged or disengaged.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="DISENGAGED">
				<xs:annotation>
					<xs:documentation>Indicates the component is disengaged.  Intended for components that are outside of the typical UCI Capability and may be on the flight side.  This state can be for components such as brakes that  report engaged or disengaged.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ON">
				<xs:annotation>
					<xs:documentation>Indicates the component is powered on.  Intended for components that are outside of the typical UCI Capability and may be on the flight side.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="WARMING">
				<xs:annotation>
					<xs:documentation>Indicates the component is warming.  Intended for components that are outside of the typical UCI Capability and may be on the flight side.  Some components have a WARMING state such as fuel and hydraulic related components and may need to be warming to a certain temperature before it can be used.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="INHIBITED">
				<xs:annotation>
					<xs:documentation>Indicates a component element is inhibited.  It could be powered on but not allowed to operate for maintenance/safety reasons.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TRANSITIONING">
				<xs:annotation>
					<xs:documentation>Indicates transitioning between states of a component element is occurring.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
