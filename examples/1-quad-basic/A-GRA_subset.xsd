	<xs:complexType name="IdentityType" uci:version="003.001.003.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Standard" type="uci:StandardIdentityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the "standard identity" of the asset.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Environment" type="uci:EnvironmentIdentityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the "environment identity" or "domain" in which the asset operates. Derived from MIL-STD-6016; see MIL-STD-6016 DFI/DUI 275/004 for additional details. Each environment has a corresponding set of specific types.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Platform" type="uci:PlatformIdentityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the "platform identity" of the asset.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Specific" type="uci:SpecificIdentityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a "specific identity" of the asset.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Emitter" type="uci:EmitterIdentityType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates an emitter type that has been identified in association with the asset.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecificEmitter" type="uci:SpecificEmitterIdentityType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Indicates a specific emitter type ***instance*** that has been identified in association with the asset.  Specific Emitter Identification (SEI) technology passively measures emitters, and characterizes unique emitter signatures that can be used for friendly or enemy emitter identification and fingerprinting.  A SEI and this SpecificEmitter element refer to a specific physical instance of a type of emitter as given in the sibling EmitterType element.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecificFacility" type="uci:FacilityIdentificationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the specific, generally blue force, facility ***instance*** that has been identified in association with the asset.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecificVehicle" type="uci:VehicleIdentificationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the specific, generally blue force, vehicle ***instance*** that has been identified in association with the asset.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EOB" type="uci:EOB_IdentityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the identity of the asset in the taxonomy/nomenclature of the Electronic Order of Battle (EOB).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Weapon" type="uci:StoreType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates a type of weapon available. This element represents the MIL-STD-6016 specific type of the store. See MIL-STD-6016 for details; this schema will not redefine the enumerations. It is left to applications using this schema to enforce compatibility with MIL-STD-6016.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="InertialStateType" uci:version="001.000.002.001">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Position" type="uci:Point4D_Type">
				<xs:annotation>
					<xs:documentation>Physical location of the referenced item in geospatial coordinates.  The use of the timestamp in this context represents the time the positional data was last measured.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PositionUncertainty" type="uci:UncertaintyType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Uncertainty of the physical location of the referenced item.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DomainVelocity" type="uci:Velocity3D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Vehicle's velocity in the current operating domain of the system.  Air vehicle components are in True Air Speed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GroundVelocity" type="uci:Velocity2D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Representation of the vehicle's ground velocity as directional speed components.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DomainAcceleration" type="uci:Acceleration3D_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The vehicle's acceleration in the current operating domain of the system.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Orientation" type="uci:OrientationType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Euler Angle Sequence describing the orientation of the vehicle in the order yaw, pitch, roll.  The angles are given in a locally level, North-East-Down coordinate system centered on the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OrientationRate" type="uci:OrientationRateType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Euler Angle Sequence describing the rate of orientation change of the vehicle in the order yaw, pitch, roll.  The angles are given in a locally level, North-East-Down coordinate system centered on the vehicle.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Link16PositionQuality" type="uci:Link16_PositionQualityType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The level of geodetic position uncertainty as estimated by the unit reporting its position via Link 16, where higher number indicates lower uncertainty and better quality. Values range from 0 to 15. (Based on MIL-STD-6016 DFI: 283 DUI: 001).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="IntPositiveType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates 32-bit integer values greater than zero with a range of [1,4294967295].</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:unsignedInt">
			<xs:minInclusive value="1" />
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="InternationalDesignatorType" uci:version="000.001.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Year" type="xs:unsignedByte">
				<xs:annotation>
					<xs:documentation>Indicates a two-digit unsigned integer capable of representing the year of an event, such as when an Earth-orbiting object was launched. A common range is [0,99].</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Number" type="xs:unsignedShort">
				<xs:annotation>
					<xs:documentation>Indicates the launch number of the year that the object was a part of. A common range is [1,999]. This is part of the unique designation for an Earth orbiting object assigned by the World Data Center-A for Rockets and Satellites (WDC-A-RS).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Piece" type="uci:LaunchPieceType">
				<xs:annotation>
					<xs:documentation>Identifier for the specific piece of a launch for the object.  This is typically an A-Z value.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
