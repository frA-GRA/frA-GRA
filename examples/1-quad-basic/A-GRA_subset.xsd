		<xs:restriction base="xs:string">
			<xs:enumeration value="HEADING">
				<xs:annotation>
					<xs:documentation>Autopilot mode where the flight path is determined by the heading, altitude and speed autopilot commands.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="BANK">
				<xs:annotation>
					<xs:documentation>Autopilot mode where the flight path is determined by the bank angle, altitude and speed autopilot commands.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CIRCLE">
				<xs:annotation>
					<xs:documentation>Autopilot mode where the flight path will follow a circular maneuver centered on a designated latitude and longitude reference point.  The altitude, speed, climb rate and time are set by autopilot commands.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="OVAL">
				<xs:annotation>
					<xs:documentation>Autopilot mode where the flight path will follow an oval maneuver around two designated latitude and longitude reference points.  The altitude, speed, climb rate and time are set by autopilot commands.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FIGURE_EIGHT">
				<xs:annotation>
					<xs:documentation>Autopilot mode where the flight path will follow a Figure eight maneuver around two designated latitude and longitude reference points.  The altitude, speed, climb rate and time are set by autopilot commands.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
