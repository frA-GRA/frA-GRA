				<xs:annotation>
					<xs:documentation>This element represents the inertial state of the system or resource.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WanderAngle" type="uci:AngleType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The angle by which the Inertial Navigation System (INS) rotates the geodetic frame about the vertical axis of the North-East-Down (NED) coordinate frame to avoid the introduction of a singularity at the North pole when it is calculating vehicle location. A rotation from true North towards East is reported as a positive angle.</xs:documentation>
