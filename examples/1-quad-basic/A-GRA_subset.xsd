	<xs:complexType name="HeaderType" uci:version="001.000.001.000">
		<xs:annotation>
			<xs:documentation>This type is for the Header used by all messages in the UCI interface.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="SystemID" type="uci:SystemID_Type">
				<xs:annotation>
					<xs:documentation>This element represents the SystemID of the System that sent this message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Timestamp" type="uci:DateTimeType">
				<xs:annotation>
					<xs:documentation>This element represents the time and date at which the message was created and ready to be sent.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SchemaVersion" type="uci:UCI_SchemaVersionStringType">
				<xs:annotation>
					<xs:documentation>Indicates the schema version used to generate the message.  UCI v2.0 would be indicated as "002.0", UCI v1.9b would be indicated as "001.9b".</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Mode" type="uci:MessageModeEnum">
				<xs:annotation>
					<xs:documentation>This enumerated element indicates the "message mode" of the message.  See enumeration values for details.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ServiceID" type="uci:ServiceID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents the ServiceID of the Service that sent this message.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MissionID" type="uci:MissionID_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Defines the Mission that this message was generated for and applies to.  Required if the message is Mission unique.  See the MissionDefinition message which defines a Mission.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="HoverType" uci:version="001.001.002.000">
		<xs:annotation>
