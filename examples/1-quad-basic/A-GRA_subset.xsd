			<xs:minLength value="4" />
			<xs:maxLength value="5" />
			<xs:pattern value="[0-9]{4,5}" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OperationalImpairmentEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the primary system component that has degraded the operational capability of the platform.  Enumeration values list the various primary system components that could have an impairment.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="NO_REPORT">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SURVEILLANCE_RADAR">
				<xs:annotation>
					<xs:documentation>No annotation will be provided.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
