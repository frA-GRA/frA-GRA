	<xs:simpleType name="TrackModeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Weapon system mode of operation in nominal order of progression. Newer weapon systems may exhibit multiple modes of operation simultaneously.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:annotation>
				<xs:documentation>This enumerated type indicates the basic tracking modes of radar systems.</xs:documentation>
			</xs:annotation>
			<xs:enumeration value="UNKNOWN">
				<xs:annotation>
					<xs:documentation>Indicates the radar's tracking mode hasn't been determined.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="SEARCH">
				<xs:annotation>
					<xs:documentation>Indicates a radar spatially scanning a volume for initial contact with an entity.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="TRACK">
				<xs:annotation>
					<xs:documentation>Indicates a radar frequently revisiting a small spatial volume to monitor to an entity.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GUIDANCE">
				<xs:annotation>
					<xs:documentation>Indicates a radar providing real-time data to another system (e.g. a missile) with the goal of steering it towards a tracked entity.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ILLUM">
				<xs:annotation>
					<xs:documentation>Indicates a radar pointing a persistent beam of energy at a target which can be exploited by another system (e.g. a missile).</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="ACQUISITION">
				<xs:annotation>
					<xs:documentation>Indicates a radar mode, similar to search, that is generally a transitory, leading to the TRACK mode.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="TurnGeometryChoiceType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>This element is used to specify whether a turn is a bank angle or turn radius.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="TurnRadius" type="uci:DistanceType">
				<xs:annotation>
					<xs:documentation>Indicates the radius of the turn.  When neither BankAngle nor TurnRadius are specified, indicates that the TurnPoint is in the end of a turn.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BankAngle" type="uci:AngleHalfType">
				<xs:annotation>
					<xs:documentation>Indicates bank angle of the turn.  When neither BankAngle nor TurnRadius are specified, indicates that the TurnPoint is in the end of a turn.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="TurnPointType" uci:version="002.001.002.001">
		<xs:annotation>
			<xs:documentation>This element is used to specify all cases of turns in a segment including fly-through and turn-short.  TurnPoints will generally come in groups of at least two in linked PathSegments.  All but the last in a group will include a TurnRadius.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Waypoint" type="uci:WayPointPointChoiceType">
				<xs:annotation>
					<xs:documentation>This element indicates the location and time of arrival of the end of the path segment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TurnPointType" type="uci:TurnPointTypeEnum">
				<xs:annotation>
					<xs:documentation>Represents the desired behavior at the associated way point.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Course" type="uci:AngleType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the course at the Waypoint of this TurnPoint.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TurnGeometry" type="uci:TurnGeometryChoiceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Indicates the bank angle or radius of the turn.  When Turn Geometry is not specified, indicates that the TurnPoint is in the end of a turn.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="TurnPointTypeEnum" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>Indicates the desired behavior at the associated turn point.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="TURN_SHORT">
				<xs:annotation>
					<xs:documentation>Indicates the vehicle is to begin the turn prior to reaching the turn point and continue turning until its projected course intercepts the next turn point.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="FLY_OVER">
				<xs:annotation>
					<xs:documentation>Indicates the vehicle is to fly directly over the turn point.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="CAPTURE_OUTBOUND_COURSE">
				<xs:annotation>
					<xs:documentation>Indicates the vehicle is to capture the specified outbound course upon reaching the turn point.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="START_TURN">
				<xs:annotation>
					<xs:documentation>Indicates the vehicle is to start the next turn upon reaching the turn point.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="END_TURN">
				<xs:annotation>
					<xs:documentation>Indicates the vehicle is to end the current turn upon reaching the turn point.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="UCI_SchemaVersionStringType" uci:version="000.000.000.000">
		<xs:annotation>
			<xs:documentation>String representing the UCI version.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="5" />
			<xs:maxLength value="53" />
			<xs:pattern value="[0-9]{3}\.[0-9]{1,2}([a-z]{1})?(\.[0-9A-Za-z_\-]{1,45})?" />
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="UncertaintyType" uci:version="001.000.000.000">
		<xs:annotation>
			<xs:documentation>See annotations in child elements and messages/elements that use this type for details.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="UncertaintyEllipse" type="uci:EllipseType">
				<xs:annotation>
					<xs:documentation>This element represents an ellipse describing the 1-sigma position uncertainty.  The ellipse is defined by the length of its semi-major and semi-minor axes.  The orientation of the ellipse defines the angle between the semi-major axis and true north.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UncertaintyVertical" type="uci:DistanceType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>This element represents 1-sigma position uncertainty perpendicular to the sibling UncertaintyEllipse surface (in the up-down direction).  Combined with the sibling UncertaintyEllipse this results in an uncertainty ellipsoid with "height".</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UncertaintyTilt" type="uci:AngleHalfType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Measured as the angle between the projection of the slant range position uncertainty axis onto the level plane and the slant range position uncertainty axis. Positive angle is measured counter-clockwise from local level.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
