			<xs:element name="Radar" type="uci:RadarEmitterIdentityType">
				<xs:annotation>
					<xs:documentation>Used for emitters identified as a Radar subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Communications" type="uci:CommunicationsEmitterIdentityType">
				<xs:annotation>
					<xs:documentation>Used for emitters identified as a communications subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Jammer" type="uci:JammerEmitterIdentityType">
				<xs:annotation>
					<xs:documentation>Used for emitters identified as an Electronic Attack subsystem.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Missile" type="uci:MissileEmitterIdentityType">
